  "magpie": {
    "name": "中文思考与过程提示",
    "middleware": "./zh-thinking.middleware.js",
    "options": {
      "zh": true,
      "process": false,
      "user_inject": "anthropic",
      "thinking": "auto"
    }
  }
}
